/* base.qss —— 全局基础样式：背景、字体、滚动条、ToolTip */

#MainWindow {
    background-color: $bg;
    border-radius: 10px;
}

QWidget {
    color: $text;
    font-family: "Microsoft YaHei";
}

QToolTip {
    background: $bg_input;
    color: $text;
    border: 1px solid $border;
}

QScrollBar {
    background: transparent;
    width: 8px;
    height: 8px;
}
QScrollBar::handle {
    background: $bg_hover;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:hover {
    background: $bg_hover2;
}
QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}
QScrollBar::vertical {
    margin: 2px;
}
QScrollBar::horizontal {
    margin: 2px;
}

